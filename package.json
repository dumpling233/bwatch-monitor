{
  "name": "bwatch-monitor",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": { "node": ">=22" },
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "predev": "node scripts/prepare-license-notices.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/prepare-license-notices.mjs",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "build:extension": "npm --prefix extension run zip",
    "build:extension:local": "npm --prefix extension run zip:local",
    "prepare:extension": "node scripts/prepare-extension-download.mjs",
    "verify:extension": "node scripts/verify-extension-download.mjs",
    "verify:standalone": "node scripts/verify-standalone.mjs",
    "build:release": "npm run build:extension && npm run prepare:extension && npm run build && npm run verify:extension && npm run verify:standalone"
  },
  "dependencies": {
    "@laplace.live/ws": "8.1.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@tanstack/react-virtual": "^3.14.26",
    "danmaku": "2.0.10",
    "hls.js": "^1.6.15",
    "lucide-react": "^0.468.0",
    "luxon": "^3.6.1",
    "mpegts.js": "^1.8.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.9",
    "adm-zip": "^0.5.16",
    "patch-package": "8.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
